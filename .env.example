# Copy values into your shell; this file is not loaded automatically.
# Never commit a real API token or key.
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
OCR_BACKEND=mineru
OCR_TIMEOUT_SECONDS=30
MINERU_TASK_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=2

# DeepSeek JSON mode; schemas are validated locally, not enforced by the provider.
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_MAX_TOKENS=8192
# Legacy key alias; DEEPSEEK_API_KEY takes precedence when nonempty.
LLM_API_KEY=
